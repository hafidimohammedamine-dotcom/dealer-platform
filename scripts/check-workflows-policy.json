{
 "_comment": "Founder-owned policy for scripts/check-workflows.py. Rules and messages: docs/runbooks/workflow-checker.md.",
 "claude_actions": [
  "anthropics/claude-code-action@2dca132ff0e0c4094ce6048b422c6915a071210b"
 ],
 "lock_action": "./.github/actions/agent-egress-lock",
 "local_actions": [
  "./.github/actions/agent-egress-lock",
  "./.github/actions/install-gitleaks"
 ],
 "claude_inputs": [
  "allowed_bots",
  "claude_args",
  "claude_code_oauth_token",
  "github_token",
  "path_to_bun_executable",
  "path_to_claude_code_executable",
  "prompt"
 ],
 "allowed_bots": {
  "agent-manager.yml": "github-actions"
 },
 "claude_flags": [
  "--add-dir",
  "--allowedTools",
  "--disallowedTools",
  "--max-turns",
  "--model",
  "--permission-mode"
 ],
 "claude_step_keys": [
  "env",
  "id",
  "if",
  "name",
  "timeout-minutes",
  "uses",
  "with"
 ],
 "default_refs": [
  "${{ github.event.repository.default_branch }}",
  "main"
 ],
 "base_ref": "${{ github.base_ref }}",
 "manager": "agent-manager.yml",
 "read_only_tools": [
  "Agent",
  "Glob",
  "Grep",
  "Read",
  "Skill",
  "Task",
  "TodoWrite"
 ],
 "read_only_bash": [
  "Bash(date:*)",
  "Bash(gh issue list:*)",
  "Bash(gh issue view:*)",
  "Bash(gh pr diff:*)",
  "Bash(gh pr list:*)",
  "Bash(gh pr view:*)",
  "Bash(gh run list:*)",
  "Bash(yarn npm audit:*)",
  "Bash(yarn npm info:*)",
  "Bash(yarn why:*)"
 ],
 "add_dirs": {
  "review.yml": [
   "/tmp/pr",
   "/tmp/pr-meta"
  ],
  "agent-weekly-audit.yml": [
   "/tmp/audit-meta"
  ]
 },
 "job_env": [
  "BASE_REF",
  "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS",
  "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB",
  "GH_TOKEN",
  "HEAD_SHA",
  "PR_NUMBER"
 ],
 "manager_denies": [
  "Skill(payload)",
  "Bash(npx:*)",
  "Bash(npm:*)",
  "Bash(yarn dlx:*)",
  "Bash(yarn create:*)",
  "Bash(node -e:*)",
  "Bash(node --eval:*)",
  "Bash(node -p:*)",
  "Bash(node --print:*)",
  "Bash(curl:*)",
  "Bash(wget:*)",
  "Bash(sudo:*)",
  "Bash(env:*)",
  "Bash(printenv:*)",
  "Bash(git push --force:*)",
  "Bash(git push -f:*)",
  "Bash(gh pr merge:*)",
  "Bash(gh api -X DELETE:*)",
  "Bash(gh secret:*)",
  "Bash(gh auth:*)",
  "Bash(gh api:*)",
  "Bash(gh gist:*)",
  "Bash(gh repo:*)",
  "WebFetch",
  "WebSearch",
  "Bash(yarn npm publish:*)",
  "Bash(yarn npm login:*)",
  "Read(//proc/**)",
  "Read(//sys/**)",
  "Read(//home/runner/work/_temp/**)",
  "Read(//home/runner/.*/**)",
  "Read(//etc/**)"
 ],
 "claude_denies": [
  "WebFetch",
  "WebSearch",
  "Read(//proc/**)",
  "Read(//sys/**)",
  "Read(//home/runner/work/_temp/**)",
  "Read(//home/runner/.*/**)",
  "Read(//etc/**)"
 ],
 "always_denied_skills": [
  "payload"
 ],
 "checkout_keys": [
  "fetch-depth",
  "persist-credentials",
  "ref"
 ],
 "extra_tools": {
  "egress-lock-claude.yml": [
   "Bash(bash scripts/check-scrub-probe.sh)"
  ]
 },
 "pr_data_runs": [
  "bash scripts/check-review-prepare.sh \"$PR_NUMBER\" /tmp/pr \"origin/$BASE_REF\""
 ],
 "runs_on": "ubuntu-latest",
 "permission_scopes": [
  "actions",
  "contents",
  "issues",
  "pull-requests",
  "statuses"
 ],
 "per_file_permission_scopes": {
  "id-token": [
   "claude.yml",
   "egress-lock-claude.yml"
  ]
 },
 "permission_values": [
  "none",
  "read",
  "write"
 ],
 "tag_mode_triggers": [
  "issue_comment",
  "issues"
 ],
 "tag_mode_job_if": "!github.event.issue.pull_request",
 "post_pin_check": "sha256sum --check --strict",
 "agent_token_secret": "AGENT_GH_TOKEN",
 "agent_token_guard": "bash scripts/check-agent-token.sh .github/accounts.txt",
 "agent_token_required_in": [
  "agent-manager.yml"
 ],
 "id_gated": {
  "agent-manager.yml": "founder",
  "claude.yml": "founder",
  "egress-lock-claude.yml": "founder",
  "review.yml": "agent"
 },
 "pins_file": ".github/pins.txt",
 "pins_step_name": "The repository files this job runs are the reviewed ones (pinned here, outside any push's reach)",
 "pins_step_run": "echo \"$PINS_SHA256  .github/pins.txt\" | sha256sum --check --strict --quiet\nsha256sum --check --strict --quiet .github/pins.txt\n",
 "pins_step_run_default_branch": "h=$(sed -n -E 's/^ *PINS_SHA256: \"([0-9a-f]{64})\".*/\\1/p' .github/workflows/guards.yml | head -n1)\necho \"$h  .github/pins.txt\" | sha256sum --check --strict --quiet\nsha256sum --check --strict --quiet .github/pins.txt\n",
 "pins_default_branch_workflows": [
  "pusher-ledger.yml"
 ],
 "pins_exempt": [
  "ci.yml",
  "egress-lock-test.yml"
 ],
 "pins_required": {
  "dirs": [".github/actions", ".claude"],
  "globs": ["scripts/check-*"],
  "files": [".gitleaks.toml", ".github/accounts.txt", "CLAUDE.md"],
  "exclude_suffixes": [".test.sh", "testlib.sh"]
 },
 "read_only_workflows": [
  "agent-manager.yml"
 ]
}
