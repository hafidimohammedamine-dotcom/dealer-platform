# Copy to .env for local dev. Never commit real values.
# Real secrets live only in Railway / GitHub secrets.

# Environment: dev | staging | production
APP_ENV=dev

# Postgres. The app user must NOT own the tables (row-level security).
DATABASE_URL=postgres://app_user:change-me@localhost:5432/dealer
# Separate owner user, used only by the CI migration job.
MIGRATION_DATABASE_URL=postgres://owner_user:change-me@localhost:5432/dealer
# Encrypted credit/finance schema owned by services/desking
DESKING_DATABASE_URL=postgres://desking_user:change-me@localhost:5432/dealer
REDIS_URL=redis://localhost:6379

# Payload (back up PAYLOAD_SECRET separately; rotating it logs everyone out)
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Field encryption key (32 bytes, base64)
FIELD_ENCRYPTION_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Texting (Telnyx)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# Voice (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# AI (Anthropic)
ANTHROPIC_API_KEY=

# Meta (Lead Ads, Messenger)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Lenders and bank callbacks
ROUTEONE_CLIENT_ID=
ROUTEONE_CLIENT_SECRET=
ROUTEONE_WEBHOOK_SECRET=
DEALERTRACK_CLIENT_ID=
DEALERTRACK_CLIENT_SECRET=
DEALERTRACK_WEBHOOK_SECRET=

# Error tracking
SENTRY_DSN=
