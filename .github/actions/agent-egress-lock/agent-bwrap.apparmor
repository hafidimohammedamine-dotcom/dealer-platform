# AppArmor profile for bubblewrap under the agent egress lock (founder-owned; loaded by lock.sh).
# The runner keeps kernel.apparmor_restrict_unprivileged_userns=1. Only /usr/bin/bwrap may create user namespaces (Claude
# Code's subprocess isolation needs it). Everything bwrap starts runs stacked under agent-bwrap-child: no capabilities and no
# new user namespaces. Stacking (not a plain transition) is needed because bwrap sets no-new-privs.
# Same structure as AppArmor's own extras/bwrap-userns-restrict, with user namespaces also denied to the children.
# Measured on a GitHub runner on 2026-10-09: bwrap (also --unshare-user / --unshare-all) works, `unshare -U` inside is denied.
abi <abi/4.0>,
include <tunables/global>

profile agent-bwrap /usr/bin/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow pix /** -> &agent-bwrap//&agent-bwrap-child,
}

profile agent-bwrap-child flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow pix /** -> &agent-bwrap-child,
  audit deny capability,
  audit deny userns,
}
